rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTeacher() {
      return isAuthenticated() && (getUserData().role == 'TEACHER' || getUserData().role == 'ADMIN');
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'ADMIN';
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Classes collection
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow create: if isTeacher();
      allow update, delete: if isTeacher() && (resource.data.teacherId == request.auth.uid || isAdmin());
    }

    // 3. Class Members collection
    match /classMembers/{memberId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isTeacher() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
    }

    // 4. Questions collection
    match /questions/{questionId} {
      // Questions are readable by any authenticated user for taking tests/practice
      // But explanation can only be viewed by teachers or when allowed
      allow read: if isAuthenticated();
      allow create, update, delete: if isTeacher();
    }

    // 5. Answer Keys collection: CRITICAL SECURITY REQUIREMENT
    // Answer keys must NEVER be readable by students!
    match /answerKeys/{questionId} {
      allow read, write: if isTeacher();
    }

    // 6. Assignments collection
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create: if isTeacher();
      allow update, delete: if isTeacher() && (resource.data.teacherId == request.auth.uid || isAdmin());
    }

    // 7. Submissions collection
    match /submissions/{submissionId} {
      // Students can read/create only their own submissions. Teachers can read submissions for their assignments.
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isTeacher()
      );
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isTeacher()
      );
      allow delete: if isTeacher() || isAdmin();
    }

    // 8. Submission Answers collection
    match /submissionAnswers/{answerId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isTeacher()
      );
      allow create, update: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow delete: if isTeacher() || isAdmin();
    }

    // 9. Student Progress collection
    match /studentProgress/{studentId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == studentId || isTeacher()
      );
      allow create, update: if isAuthenticated() && (
        request.auth.uid == studentId || isTeacher()
      );
      allow delete: if isAdmin();
    }
  }
}
